UNION ALL SELECT 'pharmacy',  COUNT(*) FROM pharmacy
UNION ALL SELECT 'lab_tests', COUNT(*) FROM lab_tests
UNION ALL SELECT 'operations',COUNT(*) FROM operations
UNION ALL SELECT 'staff',     COUNT(*) FROM staff
UNION ALL SELECT 'ward',      COUNT(*) FROM ward;
